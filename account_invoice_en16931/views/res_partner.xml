<odoo>
    <!-- EN16931 says that country is a data for
buyer and seller. So, to avoid getting error messages upon invoice generation
for missing country, it's better to put the field as required in the view
(I don't put it as required on the field definition, because it may
block other modules or data) -->
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">en16931.country.required.on.partner</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <!-- 15.0: the <div name="partner_address_country"> wrapper around
                 country_id only appeared in 16.0. Here country_id sits directly
                 in the o_address_format div, which occurs twice in the form
                 (company block, then contact block) — the one carried over from
                 16.0 is the contact block, identified by the vat field that
                 immediately follows it. -->
            <xpath
                expr="//div[hasclass('o_address_format')][following-sibling::field[@name='vat']]/field[@name='country_id']"
                position="attributes"
            >
                <attribute name="required">1</attribute>
            </xpath>
            <xpath
                expr="//field[@name='child_ids']/form//div[@name='div_address']/field[@name='country_id']"
                position="attributes"
            >
                <attribute name="required">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
