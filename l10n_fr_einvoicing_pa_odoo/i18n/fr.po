#: model:ir.model.fields,field_description:l10n_fr_einvoicing_pa_odoo.field_res_company__fr_ctc_transport_odoo
#: model:ir.model.fields,field_description:l10n_fr_einvoicing_pa_odoo.field_res_config_settings__fr_ctc_transport_odoo
msgid "Send and receive through the Odoo accredited platform"
msgstr "Envoyer et recevoir par la plateforme agréée Odoo"

#. module: l10n_fr_einvoicing_pa_odoo
#: model:ir.model.fields,help:l10n_fr_einvoicing_pa_odoo.field_res_company__fr_ctc_transport_odoo
#: model:ir.model.fields,help:l10n_fr_einvoicing_pa_odoo.field_res_config_settings__fr_ctc_transport_odoo
msgid ""
"Send the outgoing flows, receive the incoming ones and read their status "
"through the Odoo accredited platform, with the registration made by the "
"native French e-invoicing module. The directory lookups keep using the "
"accredited platform selected above and its credentials."
msgstr ""
"Envoyer les flux sortants, recevoir les flux entrants et lire leur statut "
"par la plateforme agréée Odoo, avec l'inscription faite par le module natif "
"de facturation électronique française. Les consultations de l'annuaire "
"continuent d'utiliser la plateforme agréée sélectionnée ci-dessus et ses "
"identifiants."

#. module: l10n_fr_einvoicing_pa_odoo
