<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="l10n_fr_einvoicing.res_config_settings_view_form"
        />
        <field name="arch" type="xml">
            <setting id="fr_ctc_accredited_platform" position="after">
                <setting
                    id="fr_ctc_transport_odoo"
                    help="Flows travel through the Odoo accredited platform, the directory stays on the accredited platform selected above"
                >
                    <field name="fr_ctc_transport_odoo" />
                </setting>
            </setting>
            <setting id="fr_ctc_auto_download_readable_invoice" position="attributes">
                <attribute name="invisible">fr_ctc_transport_odoo</attribute>
            </setting>
        </field>
    </record>
</odoo>
