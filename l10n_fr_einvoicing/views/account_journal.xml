<odoo>
    <record id="account_journal_dashboard_kanban_view" model="ir.ui.view">
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.account_journal_dashboard_kanban_view" />
        <field name="arch" type="xml">
            <!-- 15.0: the account_file_uploader widget only exists from 16.0 on;
                 here the same spot is the "Upload Invoices" link of the New
                 column. Anchoring on the <a> rather than on the class alone
                 keeps it unambiguous — the class is also on the <button> in the
                 card body, which is what makes the upstream xpath dirty. -->
            <xpath
                expr="//a[hasclass('o_button_upload_bill')]/../.."
                position="inside"
            >
                <div
                    id="fr_einvoicing_import_flows"
                    t-if="journal_type == 'purchase' || journal_type == 'sale'"
                >
                    <a
                        role="menuitem"
                        type="object"
                        name="fr_einvoicing_run_import_button"
                    >Import from AP Now</a>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
