<odoo>
    <record id="view_account_journal_form" model="ir.ui.view">
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form" />
        <field name="arch" type="xml">
            <!-- 16.0: group_alias_ro_general doesn't exist (no email alias on
                 general journals yet); anchor on group_alias_ro, which sits in
                 the same 2-column grid of the Advanced Settings page. -->
            <group name="group_alias_ro" position="after">
                <group
                    id="fr_ctc_invoice_import"
                    attrs="{'invisible': [('type', '!=', 'purchase')]}"
                    string="France eInvoicing"
                >
                    <field name="fr_directory_line_ids" widget="many2many_tags" />
                    <field name="company_partner_id" invisible="1" />
                </group>
            </group>
        </field>
    </record>
</odoo>
